import os
import telebot
from google import genai

TELEGRAM_TOKEN = os.environ.get("TELEGRAM_TOKEN")
GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY")

bot = telebot.TeleBot(TELEGRAM_TOKEN)
client = genai.Client(api_key=GEMINI_API_KEY)

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "Salam! Yeməyin şəklini göndərin, kalorisini və qida dəyərlərini hesablayım.")

@bot.message_handler(content_types=['photo'])
def handle_photo(message):
    try:
        file_info = bot.get_file(message.photo[-1].file_id)
        downloaded_file = bot.download_file(file_info.file_path)

        prompt = "Bu yemək şəklini analiz et. Yeməyin adını, təxmini çəkisini, kalorisini, zülal, yağ və karbohidrat miqdarını azərbaycan dilində qısa və səliqəli şəkildə yaz."

        response = client.models.generate_content(
            model='gemini-2.5-flash',
            contents=[
                prompt,
                {
                    "mime_type": "image/jpeg",
                    "data": downloaded_file
                }
            ]
        )
        bot.reply_to(message, response.text)
    except Exception as e:
        bot.reply_to(message, "Şəkli analiz edərkən xəta baş verdi. Zəhmət olmasa yenidən cəhd edin.")

@bot.message_handler(func=lambda message: True)
def echo_all(message):
    bot.reply_to(message, "Zəhmət olmasa kalori hesablamaq üçün yeməyin şəklini göndərin.")

if __name__ == "__main__":
    bot.infinity_polling()
